# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=llmops_db
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码

# Ollama 配置
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# DeepSeek 配置（可选，不填则使用 Ollama）
DEEPSEEK_API_KEY="sk-你的DeepSeek密钥"
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 混合检索（可选；默认关闭）──
# jieba/BM25 关键词召回 + bge-m3 向量召回，用 RRF 融合成候选池；专治精确编号/型号类问题。
# 依赖已随 requirements.txt 安装（jieba），首次开启/文档变更后自动重建内存索引，无需重新灌库。
# 可与精排同时开启：混合候选 → 精排 → 阈值截断。
RAG_HYBRID_ENABLED=false
RAG_HYBRID_DENSE_K=12
RAG_HYBRID_SPARSE_K=12
RAG_HYBRID_RRF_K=60

# ── 检索阈值（2026-11-17 在 196 篇 / 338 片段 / 183 题上重扫，见 docs/13）──
# cosine 0.53 覆盖率 100% 但无答案误接受 80%；0.56 覆盖不变、误接受降到 71.4%，是不丢正确片段的上限。
# 精排 0.76 留下 30% 近域误接受；0.90 覆盖 96.6% / 误接受 5.7%；0.92 覆盖不变、误接受降到 2.9%（线上取值）；
# 0.95 覆盖 94.6% / 误接受 0%，且 0.95+0.06 余量=1.01 会让所有命中都判成 weak_hit，故不取。
# 上下文按文档去重：同一篇文档只保留最相关的一个片段，避免长文档吃满 top-3（docs/15）。
RAG_DEDUP_BY_DOC=true

RAG_SCORE_THRESHOLD=0.56
RAG_RERANK_SCORE_THRESHOLD=0.92

# ── 精排运行位置（docs/16）──
# local = 进程内 torch 加载 2.27GB 权重（有 GPU 且显存够大时最快，约 260ms/问）；
# cloud = 调服务商 /rerank API，不占显存（约 400ms/问，依赖外网），小显存机器/2C2G 用这个。
# 6GB 显存 + 本地 7B 聊天模型时 local 会 CUDA OOM 并静默回退 cosine，务必确认 meta.rerank_available。
# cloud 模式的 key 走系统环境变量 SILICONFLOW_API_KEY（或 RAG_RERANK_API_KEY），不要写进本文件。
RAG_RERANK_PROVIDER=cloud
RAG_RERANK_API_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_API_TIMEOUT=10

# ── 拒答策略（docs/17）──
# 命中时提示词收紧为「只依据片段回答，片段没有就说未收录，并标注片段编号」；
# 无命中时不调模型、直接回固定话术（省掉一次生成，也避免模型用常识编数字）。
# 想回到「允许结合通用知识补充」的旧行为，把这两个开关都置 false。
RAG_STRICT_GROUNDING=true
RAG_NO_HIT_REPLY_ENABLED=true
# 生成后数字校验：回答里出现、片段里找不到的数字会追加提示（docs/19）。
RAG_NUMERIC_GUARD_ENABLED=true

# ── 多轮检索改写（可选；docs/14）──
# 把「那它的更换周期呢」补成可独立检索的完整问句，只改检索查询，用户原文照旧用于生成。
# off = 关闭；rule = 规则改写（零延迟，从头几轮抽型号回填，失败退原句）；
# llm = 模型改写（每轮多一次调用；本地 7B 推理模型单次 20s+，会被下面的超时打断并退回 rule）。
RAG_QUERY_REWRITE_MODE=rule
RAG_QUERY_REWRITE_TIMEOUT=1.5
RAG_QUERY_REWRITE_FALLBACK=rule

# ── 输入清洗（可选；默认关闭）──
# 把用户粘贴的脏文本先规范化再进检索/生成：零宽字符、全角型号、重复字、HTML 残留、
# PDF 折断的硬换行都会把 bge-m3 向量带偏，型号类查询还会让精确编号豁免失效。
# off = 关闭；rule = 纯规则（毫秒级、零依赖，随代码走）；model = 调独立清洗服务（蒸馏 0.8B）。
# rule 通道直接可用；model 通道需另起 tools/clean_server.py（约 1.6GB 权重，见 docs/08）。
# 任何失败都不会打断问答：按 INPUT_CLEAN_FALLBACK 回退（rule / off）。
INPUT_CLEAN_MODE=off
# model 模式的清洗服务地址
INPUT_CLEAN_SERVER_URL=http://127.0.0.1:8010
# 单次清洗超时（秒）：CPU 上约 0.3–1s，留 5s 兜冷启动
INPUT_CLEAN_TIMEOUT=5
# 清洗失败兜底：rule = 退回规则清洗；off = 直接用原文
INPUT_CLEAN_FALLBACK=rule
# 超过这个长度不清洗（模型通道会拖慢首字）
INPUT_CLEAN_MAX_CHARS=4000
# 是否允许「请求级精细清洗」：前端「精细清洗」开关为 true 时，本次请求升级到 model 通道。
# 主链路仍按 INPUT_CLEAN_MODE 走（建议 rule），所以默认 true 不会让每次都变慢。
# 没有 GPU（模型通道 CPU 上 0.3–1s/次）或不想让人滥用时置 false：按钮隐藏，请求里的 true 被忽略。
INPUT_CLEAN_MODEL_ALLOWED=true
