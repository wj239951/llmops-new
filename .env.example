# 复制本文件为 .env 后使用：cp .env.example .env（Windows: copy .env.example .env）
# .env 不会进 git，也不会进镜像，只被 docker compose 读取

# 【必填】MySQL root 密码。首次启动会用它建库，backend 也用它连库。
# 只用大小写字母 + 数字：后端是把密码拼进 mysql+pymysql:// 连接串里的，
# 出现 @ : / # 这类字符会让连接串解析错位。
# 注意：不要用已经在本机 3306 上跑着的那个 MySQL 的密码，这里是容器里的新实例。
MYSQL_PASSWORD=改成一个大字母数字组合的强密码

# ── 本地模型通道（Ollama 装在宿主机；容器经 host.docker.internal 访问，Windows 原生部署改成 127.0.0.1）──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# 向量化通道：ollama（本地，需要上面两个模型已 pull）| siliconflow（云端，不用装 Ollama）
EMBEDDING_PROVIDER=ollama
# 仅 EMBEDDING_PROVIDER=siliconflow 时必填
SILICONFLOW_API_KEY=

# ── DeepSeek 云端对话通道（可选，不填则只有本地 Ollama）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型名只有这两个：deepseek-chat（通用）/ deepseek-reasoner（带思考链）
DEEPSEEK_MODEL=deepseek-chat

# 前端进入页面时要输的演示口令，前后端共用同一个值
DEMO_PASSWORD=demo2026

# ── 检索调优（可不改）──
# cosine 相似度阈值，低于它的命中会被丢弃。源机是针对那批文档调出来的 0.53，
# 换成你自己的知识库后如果召回过严，往下调（0.45 左右）再试
RAG_SCORE_THRESHOLD=0.53
# 会话记忆一次加载的历史轮数
MEMORY_MAX_TURNS=10

# ── RAG 第二阶段精排（可选；默认关闭）──
# 开启前先装依赖：pip install -r requirements-rerank.txt
# 再把 bge-reranker-v2-m3 权重下载到本地（见 README「可选：开启 RAG 精排」）
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 本地权重目录；留空则按模型名从 HF 缓存/网络加载
RAG_RERANK_MODEL_PATH=
# 精排前 bge-m3 召回多少条候选（45 题实测 K=6 已 100% 召回；K=12 质量相同但 CPU 耗时约 2.4 倍）
RAG_RERANK_CANDIDATE_K=6
# 精排分数 = sigmoid(logit)，与 cosine 不同尺度；0.76 是本机 45 题标定值（见 docs/05），
# 距最高误接受样本 0.7509 仅 0.009，换语料必须重扫
RAG_RERANK_SCORE_THRESHOLD=0.76
RAG_RERANK_WEAK_MARGIN=0.06
RAG_RERANK_DEVICE=auto
# 运行模式：local = 本机 torch 加载权重；cloud = 调云端 /rerank API。
# 2核2G 等小内存服务器跑不动 2.27GB 权重，设 cloud：不装 torch、不占权重内存。
# cloud 分数是服务商 relevance_score，与 local 的 sigmoid(logit) 尺度不同，阈值须重扫（docs/05）
RAG_RERANK_PROVIDER=local
# cloud 模式 /rerank 端点前缀（含 /v1 或 /v2）；SiliconFlow / Jina / Cohere v2 同构
RAG_RERANK_API_BASE_URL=https://api.siliconflow.cn/v1
# cloud 模式 key；留空复用 SILICONFLOW_API_KEY（同一家硅基流动账号不用填两遍）
RAG_RERANK_API_KEY=
RAG_RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_API_TIMEOUT=10
# 复合问题查询分解：拆主题子问句各自过精排闸门后合并（专治「报销+制度」这类跨文档问句）。
# 开启后每问多一次 LLM 调用（走 DEFAULT_MODEL_PROVIDER），失败自动回退原句
RAG_QUERY_DECOMPOSE_ENABLED=false

# ── 混合检索（可选；默认关闭）──
# jieba/BM25 关键词召回 + bge-m3 向量召回，用 RRF 融合成候选池；专治精确编号/型号类问题。
# 依赖已随 requirements.txt 安装（jieba），首次开启/文档变更后自动重建内存索引，无需重新灌库。
# 可与精排同时开启：混合候选 → 精排 → 阈值截断。
RAG_HYBRID_ENABLED=false
RAG_HYBRID_DENSE_K=12
RAG_HYBRID_SPARSE_K=12
RAG_HYBRID_RRF_K=60
