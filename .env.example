# 复制本文件为 .env 后使用：cp .env.example .env（Windows: copy .env.example .env）
# .env 不会进 git，也不会进镜像，只被 docker compose 读取

# 【必填】MySQL root 密码。首次启动会用它建库，backend 也用它连库。
# 只用大小写字母 + 数字：后端是把密码拼进 mysql+pymysql:// 连接串里的，
# 出现 @ : / # 这类字符会让连接串解析错位。
# 注意：不要用已经在本机 3306 上跑着的那个 MySQL 的密码，这里是容器里的新实例。
MYSQL_PASSWORD=改成一个大字母数字组合的强密码

# ── 本地模型通道（Ollama 装在宿主机，容器通过 host.docker.internal 访问）──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# 向量化通道：ollama（本地，需要上面两个模型已 pull）| siliconflow（云端，不用装 Ollama）
EMBEDDING_PROVIDER=ollama
# 仅 EMBEDDING_PROVIDER=siliconflow 时必填
SILICONFLOW_API_KEY=

# ── DeepSeek 云端对话通道（可选，不填则只有本地 Ollama）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型名只有这两个：deepseek-chat（通用）/ deepseek-reasoner（带思考链）
DEEPSEEK_MODEL=deepseek-chat

# 前端进入页面时要输的演示口令，前后端共用同一个值
DEMO_PASSWORD=demo2026

# ── 检索调优（可不改）──
# cosine 相似度阈值，低于它的命中会被丢弃。源机是针对那批文档调出来的 0.53，
# 换成你自己的知识库后如果召回过严，往下调（0.45 左右）再试
RAG_SCORE_THRESHOLD=0.53
# 会话记忆一次加载的历史轮数
MEMORY_MAX_TURNS=10
