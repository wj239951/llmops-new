# 根目录：start.ps1 / stop.ps1 与手工启动产生的运行时日志，不入库
*.log

# 本机部署产生的临时验证文件
tmp-*.json
*-out.json

# 环境变量文件：docker compose 读取根目录 .env（含 MYSQL_PASSWORD / API Key），绝不入库
.env
.env.*
!.env.example

# 子项目各自的忽略规则见 llmops-backend/.gitignore 与 llmops-frontend/.gitignore
# （.venv / chroma_db / node_modules / dist 等均在各自文件里已忽略）

# IDE 配置
.idea/
.vscode/
